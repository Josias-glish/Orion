{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Registro Caprino",
  "version": "0.4.0",
  "identifier": "co.registrocaprino.escritorio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Registro Caprino",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "img-src": "'self' data: blob: asset: http://asset.localhost",
        "style-src": "'self'",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      },
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPCONFIG/fotos/**/*"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Registro de cabras lecheras",
    "longDescription": "Genealogía, reproducción, leche, pesos y salud de cabras lecheras, sin conexión a internet.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "es-ES"
      },
      "nsis": {
        "languages": [
          "Spanish"
        ]
      }
    },
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
